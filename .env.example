# Copy to .env.local and fill in. NEVER commit .env.local. Only VITE_* values here, and they are PUBLIC
# (baked into the site). Server secrets go to Base44 instead:  npx base44 secrets set NAME=value
#   FIELD_ENCRYPTION_KEY (32 random bytes, base64 — docs/07 §4), STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   STRIPE_PRICE_STARTER (€39/mes), STRIPE_PRICE_PRO (€79/mes), DEMO_PHONE_NUMBER_ID, DEMO_WA_TOKEN,
#   DEMO_TEMPLATE_NAME, TURNSTILE_SECRET, FOUNDER_ALERT_WEBHOOK, SITE_URL,
#   META_APP_SECRET, WEBHOOK_VERIFY_TOKEN, META_ACCESS_TOKEN, GEMINI_API_KEY (optional), GEMINI_MODEL (optional),
#   STRIPE_PRICE_FOUNDER_YEAR (59 €/año), STRIPE_PRICE_FOUNDER_MONTHLY (29 €/mes, desde el año 2),
#   CRON_KEY (shared secret the scheduler sends as X-Cron-Key to ticketNotifySweep)

# Base44 app id (base44/.app.jsonc after `npx base44 link`)
VITE_BASE44_APP_ID=
# Local dev only: the deployed app URL, so `npm run dev` can proxy /functions/* to it
VITE_BASE44_APP_URL=https://your-app.base44.app

# Cloudflare Turnstile site key (REQUIRED in production)
VITE_TURNSTILE_SITE_KEY=

# Datos del titular (LSSI art. 10). OBLIGATORIOS antes del lanzamiento: sin ellos el pie y /privacidad no los muestran.
VITE_LEGAL_NAME=
VITE_LEGAL_CIF=
VITE_LEGAL_ADDRESS=
VITE_PRIVACY_EMAIL=
