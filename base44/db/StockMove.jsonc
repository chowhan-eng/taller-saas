{
  "name": "StockMove",
  "type": "object",
  "description": "Audit trail of manual stock adjustments of a TPV product (who, how many, why).",
  "properties": {
    "tenant_id": { "type": "string" },
    "product_id": { "type": "string" },
    "product_name": { "type": "string", "maxLength": 120 },
    "delta": { "type": "integer", "description": "Units added (+) or removed (−)" },
    "stock_after": { "type": "integer" },
    "reason": { "type": "string", "maxLength": 200 },
    "actor_id": { "type": "string" }
  },
  "required": ["tenant_id", "product_id", "delta"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
