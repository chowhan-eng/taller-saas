// Ported from the removed supabase/migrations. See docs/07-BASE44-ARCHITECTURE.md.
{
  "name": "TicketCounter",
  "type": "object",
  "description": "Per-tenant yearly ticket sequence. SQL: public.ticket_counters",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id. Immutable after create (enforced in backend functions)."
    },
    "year": {
      "type": "integer"
    },
    "last_value": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "year",
    "last_value"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
