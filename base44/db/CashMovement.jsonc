// Ported from the removed supabase/migrations. See docs/07-BASE44-ARCHITECTURE.md.
{
  "name": "CashMovement",
  "type": "object",
  "description": "Append-only money movement of a cash session (sales by payment method, refunds, cash in/out). Ported from TPV CashMovement + Sale payments.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id. Immutable after create (enforced in backend functions)."
    },
    "closing_id": {
      "type": "string",
      "description": "CashClosing id (same tenant; enforced in backend functions)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "sale",
        "refund",
        "cash_in",
        "cash_out"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "bizum",
        "transfer",
        "deposit",
        "voucher"
      ],
      "default": "cash"
    },
    "amount_eur": {
      "type": "number",
      "minimum": 0,
      "description": "Always positive; kind decides the sign"
    },
    "ticket_id": {
      "type": "string",
      "description": "RepairTicket id (same tenant; enforced in backend functions)"
    },
    "fiscal_document_id": {
      "type": "string",
      "description": "FiscalDocument id (same tenant; enforced in backend functions)"
    },
    "refund_of": {
      "type": "string",
      "description": "sale_ref of the sale this refund returns"
    },
    "sale_ref": {
      "type": "string",
      "description": "Groups the payments of one sale"
    },
    "reason": {
      "type": "string"
    },
    "person": {
      "type": "string",
      "description": "Who takes the cash on a withdrawal"
    },
    "client_request_id": {
      "type": "string",
      "description": "Idempotency: the same request is recorded once (double click, slow CashDro, retry)"
    },
    "cashdro_operation_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "closing_id",
    "kind",
    "method",
    "amount_eur"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
