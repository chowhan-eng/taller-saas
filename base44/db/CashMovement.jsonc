// Ported from the removed supabase/migrations. See docs/07-BASE44-ARCHITECTURE.md.
{
  "name": "CashMovement",
  "type": "object",
  "description": "Append-only cash movement. SQL: public.cash_movements",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id. Immutable after create (enforced in backend functions)."
    },
    "closing_id": {
      "type": "string",
      "description": "CashClosing id (same tenant; enforced in backend functions)"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "apertura",
        "venta_efectivo",
        "venta_tarjeta",
        "venta_bizum",
        "senal_deposito",
        "devolucion",
        "entrada_manual",
        "salida_manual",
        "retirada_banco"
      ]
    },
    "amount_eur": {
      "type": "number",
      "description": "positive = in, negative = out"
    },
    "ticket_id": {
      "type": "string",
      "description": "RepairTicket id (same tenant; enforced in backend functions)"
    },
    "fiscal_document_id": {
      "type": "string",
      "description": "FiscalDocument id (same tenant; enforced in backend functions)"
    },
    "concept": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "closing_id",
    "movement_type",
    "amount_eur"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
