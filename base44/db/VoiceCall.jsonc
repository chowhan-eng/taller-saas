// Ported from the removed supabase/migrations. See docs/07-BASE44-ARCHITECTURE.md.
{
  "name": "VoiceCall",
  "type": "object",
  "description": "Consented AI voice callbacks. SQL: public.voice_calls (002)",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Lead id (same tenant; enforced in backend functions)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "callback"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "dialing",
        "completed",
        "no_answer",
        "failed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "attempts": {
      "type": "integer",
      "default": 0
    },
    "provider": {
      "type": "string",
      "default": "retell"
    },
    "provider_call_id": {
      "type": "string"
    },
    "from_phone": {
      "type": "string"
    },
    "to_phone": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "description": "quiere_comprar | link_enviado | demo_agendada | pide_humano | no_interesa | no_es_taller | do_not_call | buzon"
    },
    "duration_sec": {
      "type": "integer"
    },
    "cost_eur": {
      "type": "number"
    },
    "summary": {
      "type": "string",
      "description": "short summary only; full transcript stays at provider (30-day retention)"
    }
  },
  "required": [
    "direction"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
