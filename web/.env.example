# Copy to .env.local and fill in. NEVER commit .env.local.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — used by /api routes, never shipped to the browser

# Stripe (test mode first). Create 2 recurring Prices in EUR and paste their IDs.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen` locally or the Dashboard endpoint
STRIPE_PRICE_STARTER=price_...      # €29/mes
STRIPE_PRICE_PRO=price_...          # €69/mes

# WhatsApp demo (platform WABA, docs/03 §4.1). Template: demo_taller_listo (es, 1 body variable)
DEMO_PHONE_NUMBER_ID=
DEMO_WA_TOKEN=
DEMO_TEMPLATE_NAME=demo_taller_listo

# Cloudflare Turnstile (optional in dev; REQUIRED in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Founder alert (Slack/Discord-compatible webhook that accepts {"text": "..."}; optional)
FOUNDER_ALERT_WEBHOOK=
